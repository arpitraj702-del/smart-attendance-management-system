# Copy this file to ".env" and edit the values.
SECRET_KEY=replace-this-with-a-long-random-string

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=smart_attendance

# Login for the web app
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# Face matching (cosine similarity, SFace model). Higher = stricter.
# 0.363 is the OpenCV-recommended threshold; 0.40 is used here to be safer.
MATCH_THRESHOLD=0.40
# If the 2nd-best student is within this margin of the best match, the face is treated as Unknown.
MATCH_MARGIN=0.05
# A face must be matched in this many consecutive frames before attendance is saved.
CONFIRM_FRAMES=2
